#include<stdio.h>
#include<stdlib.h>

int main()
{
    int a, b, c, x;
    scanf("%d %d %d %d", &a, &b, &c, &x);
    if((a % 2 == 0 && b % 2 == 0) || (a % 2 == 0 && c % 2 == 0) || (b % 2 == 0 && c % 2 == 0)){
        for(int i = 1; i <= x; i++){
            if(i % 2 == 0){
                printf("%d ", i);
            }
        }
    }
    else{
        for(int i = x; i >= 1; i--){
            if(i % 2 != 0){
                printf("%d ", i);
            }
        }
    }
    
    return 0;
}
