
int main()
{
int n;
scanf("%d",&n);
int array[n];
for(int i=0;i<n;i++){
    scanf("%d",&array[i]);
}
sort(array,n);
return 0;
}
void sort(int array[],int n){
    for(int i=0;i<n-1;i++){
        for(int j=0;j<n-1;j++){
            if(array[j]>array[j+1]){
                int temp=array[j];
                array[j]=array[j+1];
                array[j+1]=temp;
            }
        }
    }
    int prime=0;
    for(int i=0;i<n;i++){
        int flag=1;
        if(array[i]<=1){
            flag=0;
        }
        for(int j=2;j<array[i];j++){
            if(array[i]%j==0){
                flag=0;
                break;
            }
        }
        if(flag==1){
            printf("%d ",array[i]);
            prime=1;
        }
    }
    if(prime==0){
        printf("-1");
        }
}
