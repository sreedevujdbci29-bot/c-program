#include <stdio.h>
#include <stdlib.h>

int thirdMax(int* nums, int numsSize) {
    // Pointers to track the top three distinct maximum values
    int *first = NULL;
    int *second = NULL;
    int *third = NULL;
    
    for (int i = 0; i < numsSize; i++) {
        int current = nums[i];
        
        // Skip duplicates to ensure distinct maximums
        if ((first != NULL && current == *first) || 
            (second != NULL && current == *second) || 
            (third != NULL && current == *third)) {
            continue;
        }
        
        // Cascade values downwards to make room for new maximums
        if (first == NULL || current > *first) {
            third = second;
            second = first;
            first = &nums[i];
        } else if (second == NULL || current > *second) {
            third = second;
            second = &nums[i];
        } else if (third == NULL || current > *third) {
            third = &nums[i];
        }
    }
    
    // If a third distinct maximum does not exist, return the absolute maximum
    if (third == NULL) {
        return *first;
    }
    
    return *third;
}
