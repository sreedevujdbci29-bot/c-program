#include <stdio.h>

int removeDuplicates(int* nums, int numsSize) {
    // An empty array or an array with 1 element has no duplicates
    if (numsSize == 0) {
        return 0;
    }
    
    int k = 1; // Tracks the position of the next unique element
    
    for (int i = 1; i < numsSize; i++) {
        // If the current element is different from the last unique element found
        if (nums[i] != nums[k - 1]) {
            nums[k] = nums[i]; // Move the unique element forward
            k++;               // Increment the unique element counter
        }
    }
    
    return k; // Return the total number of unique elements
}
