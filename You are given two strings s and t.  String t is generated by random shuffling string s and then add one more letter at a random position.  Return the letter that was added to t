char findTheDifference(char* s, char* t) {
    char result = 0;
    
    // XOR all characters in string s
    while (*s) {
        result ^= *s++;
    }
    
    // XOR all characters in string t
    while (*t) {
        result ^= *t++;
    }
    
    // The remaining value is the added letter
    return result;
}
