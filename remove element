#include <stdio.h>

int removeElement(int* nums, int numsSize, int val) {
    int k = 0; // Pointer to keep track of the position for non-val elements
    
    for (int i = 0; i < numsSize; i++) {
        // If the current element is not the target value
        if (nums[i] != val) {
            nums[k] = nums[i]; // Move it to the front
            k++;              // Increment the count of valid elements
        }
    }
    
    return k; // k is the total number of elements not equal to val
}
